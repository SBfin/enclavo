# Users sign in with a NEAR wallet. testnet (default) or mainnet; baked into the web build.
# NEXT_PUBLIC_NEAR_NETWORK=testnet
# Optional RPC used to check a signing key belongs to the account (defaults to FastNEAR).
# NEAR_RPC_URL=

# Required by the default live gateway. Obtain a funded key from https://cloud.near.ai.
NEAR_AI_API_KEY=
# Preferred default. All supported, ready confidential chat models are listed by default.
NEAR_AI_MODEL=z-ai/glm-5.3-flash
# Optional comma-separated allowlist. Leave unset to discover every supported model.
# NEAR_AI_MODELS=z-ai/glm-5.3-flash,Qwen/Qwen3.8-27B

# Dashboard-to-gateway secret, shared by web and gateway. It also keys NEAR sign-in sessions.
# Required in deployments (openssl rand -hex 32); Docker Compose uses a local default.
# ENCLAVO_CONTROL_TOKEN=

# Optional when running the frontend outside Docker (default: http://127.0.0.1:8088).
ENCLAVO_GATEWAY_URL=

# Local production-image rehearsal only (compose.staging.yaml). Generate with openssl rand -hex 32.
# STAGING_CONTROL_TOKEN=

# Cloud gateway runtime overrides (Fly templates configure these; leave unset locally).
# ENCLAVO_LISTEN=[::]:8080
# ENCLAVO_METRICS_LISTEN=0.0.0.0:9091
# ENCLAVO_PUBLIC_URL=https://YOUR_WEB_APP.fly.dev/api
# ENCLAVO_DRAIN_TIMEOUT_SECS=280

# NEAR auction contract the gateway mirrors: entitlements won on chain become capacity contracts
# and wallet-authorized key hashes become API keys (see contracts/README.md). Docker Compose
# defaults to the testnet deployment; set it empty to run without the chain.
# ENCLAVO_AUCTION_CONTRACT=enclavo-auction.testnet
# ENCLAVO_NEAR_RPC_URL=https://test.rpc.fastnear.com
