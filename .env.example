NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Required by the default live gateway. Obtain a funded key from https://cloud.near.ai.
NEAR_AI_API_KEY=
# Must exist and be ready in NEAR AI's current catalog; IDs and prices are checked on startup.
NEAR_AI_MODEL=z-ai/glm-5.3-flash

# Optional when running the frontend outside Docker (default: http://127.0.0.1:8088).
ENCLAVO_GATEWAY_URL=
